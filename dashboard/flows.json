  {
    "id": "cardio-stale",
    "type": "function",
    "z": "cardio-tab",
    "name": "Estado desatualizado após 15 s",
    "func": "const p=flow.get('latest');if(!p || Date.now()-Date.parse(p.received_at)>15000)return {payload:'SEM DADOS RECENTES — não inferir estado normal'};return null;",
    "outputs": 1,
    "x": 420,
    "y": 300,
    "wires": [
