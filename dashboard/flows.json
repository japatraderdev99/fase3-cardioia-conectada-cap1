    "complete": "payload",
    "x": 740,
    "y": 300,
    "wires": []
  },
  {
    "id": "cardio-http",
    "type": "http in",
    "z": "cardio-tab",
    "name": "Estado local para QA",
    "url": "/api/state",
    "method": "get",
    "upload": false,
    "swaggerDoc": "",
