  {
    "id": "cardio-mqtt",
    "type": "mqtt in",
    "z": "cardio-tab",
    "name": "Telemetria sintética",
    "topic": "cardioia/rm568506/telemetry",
    "qos": "0",
    "datatype": "auto-detect",
    "broker": "cardio-broker",
    "nl": false,
    "rap": true,
    "rh": 0,
    "x": 150,
    "y": 100,
    "wires": [
      [
        "cardio-validate"
      ]
    ]
  },
  {
    "id": "cardio-validate",
    "type": "function",
    "z": "cardio-tab",
    "name": "Validar / deduplicar / classificar",
    "func": "let p=msg.payload;\ntry { if (typeof p === \"string\" || Buffer.isBuffer(p)) p=JSON.parse(p.toString()); } catch(e) { return null; }\nif (!p || p.sensor_error !== false || typeof p.device_id !== 'string' || !/^[A-Za-z0-9_-]{1,64}$/.test(p.device_id) || !Number.isFinite(p.acceleration) || p.acceleration<0 || p.acceleration>200 || !Number.isInteger(p.uptime_ms) || p.uptime_ms<0 || p.uptime_ms>4294967295 || !Number.isInteger(p.age_ms) || p.age_ms<0 || p.age_ms>4294967295 || p.synthetic !== true || !Number.isFinite(p.bpm) || p.bpm<0 || p.bpm>250 || !Number.isFinite(p.temperature) || p.temperature < -40 || p.temperature > 80 || !Number.isFinite(p.humidity) || p.humidity<0 || p.humidity>100 || !Number.isInteger(p.seq) || p.seq<0 || typeof p.session_id !== 'string' || p.session_id.length>80) { node.warn('telemetria inválida rejeitada'); return null; }\n// Deduplicação limitada em memória; não autentica a origem no broker público.\nconst stream=p.device_id+':'+p.session_id; const key=stream+':'+p.seq; let seen=context.get('seen')||[];\nlet streams=context.get('streams')||{};if(streams[stream]!==undefined && p.seq<=streams[stream])return null;\nstreams[stream]=p.seq;const keys=Object.keys(streams);if(keys.length>2000)delete streams[keys[0]];context.set('streams',streams);\nif (seen.includes(key)) return null; seen.push(key); if(seen.length>2000) seen.shift();context.set('seen',seen);\nconst alerts=[];if(p.bpm>120)alerts.push('BPM > 120');if(p.temperature>38)alerts.push('temperatura > 38 °C');\nconst status=(p.age_ms>15000?'BACKLOG — amostra antiga, não representa estado atual | ':'')+(alerts.length ? 'ALERTA DIDÁTICO: '+alerts.join(' | ') : 'Dentro dos limites didáticos');\nconst record={...p,received_at:new Date().toISOString(),alert:alerts.length>0,backlog:p.age_ms>15000,status};\nflow.set('latest',record);flow.set('accepted',(flow.get('accepted')||0)+1);\nreturn [{payload:p.bpm,topic:'BPM sintético'},{payload:p.temperature},{payload:status},{payload:record}];",
    "outputs": 4,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 410,
    "y": 100,
    "wires": [
      [
        "cardio-chart"
      ],
      [
        "cardio-gauge"
      ],
      [
        "cardio-alert"
      ],
      [
        "cardio-debug"
      ]
    ]
  },
