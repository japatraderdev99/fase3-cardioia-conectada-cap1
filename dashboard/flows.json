        "cardio-state"
      ]
    ]
  },
  {
    "id": "cardio-state",
    "type": "function",
    "z": "cardio-tab",
    "name": "Snapshot somente leitura",
    "func": "const latest=flow.get('latest')||null;msg.payload={synthetic:true,accepted:flow.get('accepted')||0,latest,stale:!latest||Date.now()-Date.parse(latest.received_at)>15000};return msg;",
    "outputs": 1,
    "x": 420,
    "y": 400,
    "wires": [
      [
        "cardio-response"
      ]
    ]
  },
  {
    "id": "cardio-response",
